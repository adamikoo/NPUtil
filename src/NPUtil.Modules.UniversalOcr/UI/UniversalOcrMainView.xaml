<UserControl x:Class="NPUtil.Modules.UniversalOcr.UI.UniversalOcrMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Universal OCR &amp; Translator" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="Capture any region of your screen or load images to perform local OCR and instant bilingual translation."
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Capture & Toolbar Card -->
        <ui:Card Grid.Row="1" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="BtnSnipScreen" Grid.Column="0" Content="Snip Screen Area" Appearance="Primary" Height="36" Padding="16,0" Click="BtnSnipScreen_Click" Margin="0,0,10,0" />
                <ui:Button x:Name="BtnLoadImage" Grid.Column="1" Content="Load Image File(s)..." Appearance="Secondary" Height="36" Click="BtnLoadImage_Click" Margin="0,0,16,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Translation Direction:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <ComboBox x:Name="CmbTranslationDirection" Height="36" Width="180" SelectedIndex="0" SelectionChanged="CmbTranslationDirection_SelectionChanged">
                        <ComboBoxItem Content="Auto (Detect ↔ Opposite)" Tag="auto" />
                        <ComboBoxItem Content="Čeština → English" Tag="cs-en" />
                        <ComboBoxItem Content="English → Čeština" Tag="en-cs" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnSendToAssistant" Content="Send to Assistant" Appearance="Secondary" Height="36" Click="BtnSendToAssistant_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="BtnSendToExtractor" Content="Send to Extractor" Appearance="Secondary" Height="36" Click="BtnSendToExtractor_Click" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Side-by-Side OCR and Translation Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Original Recognized Text -->
            <ui:Card Grid.Column="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Original Recognized Text" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="TxtSourceLangInfo" Text="Source: Ready" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button x:Name="BtnCopyOriginal" Content="Copy Text" Appearance="Secondary" HorizontalAlignment="Right" Click="BtnCopyOriginal_Click" />
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                        <TextBox x:Name="TxtOriginalText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontSize="13" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="0"
                                 TextChanged="TxtOriginalText_TextChanged"
                                 Text="Click 'Snip Screen Area' or load an image to recognize text..." />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtOcrStats" Text="0 lines recognized" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- Right: Translated Text -->
            <ui:Card Grid.Column="2" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Translated Text" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="TxtTargetLangInfo" Text="Target: English" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button x:Name="BtnCopyTranslation" Content="Copy Translation" Appearance="Secondary" HorizontalAlignment="Right" Click="BtnCopyTranslation_Click" />
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                        <TextBox x:Name="TxtTranslatedText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontSize="13" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="0"
                                 Text="Translation will appear here in real time..." />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtTranslationStats" Text="100% Local Offline Translation" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
