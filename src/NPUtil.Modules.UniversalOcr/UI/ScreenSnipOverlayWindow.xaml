<Window x:Class="NPUtil.Modules.UniversalOcr.UI.ScreenSnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Region Selector"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Normal"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid">
        <!-- Display frozen desktop screenshot -->
        <Image x:Name="ImgFrozenDesktop" Stretch="Fill" />

        <!-- Dark dimming overlay -->
        <Border Background="#44000000" />

        <Canvas x:Name="CanvasOverlay">
            <Rectangle x:Name="RectSelection"
                       Stroke="{DynamicResource PrimaryContainerBrush}"
                       StrokeThickness="2"
                       Fill="#1560CDFF"
                       Visibility="Collapsed" />
            <Border x:Name="BadgeHint" Background="#E5131315" BorderBrush="#353437" BorderThickness="1" CornerRadius="6" Padding="14,8" Canvas.Top="32" Canvas.Left="32">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✦ " Foreground="{DynamicResource PrimaryContainerBrush}" FontWeight="Bold" />
                    <TextBlock Text="Drag to select screen area for NPU OCR (Esc to exit)" Foreground="#E4E2E4" FontSize="13" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
