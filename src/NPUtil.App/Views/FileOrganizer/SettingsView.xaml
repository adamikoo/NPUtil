<UserControl x:Class="NPUtil.App.Views.FileOrganizer.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:NPUtil.App.Common"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="760" HorizontalAlignment="Left">
            
            <!-- Page Header -->
            <TextBlock Text="{loc:Loc ModuleSettingsTitle}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="{loc:Loc ModuleSettingsSubtitle}"
                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />

            <!-- Directory Monitoring Section -->
            <TextBlock Text="{loc:Loc WatchedDirSection}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
            <ui:Card Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc WatchedPathLabel}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtWatchedPath" Grid.Column="0" Margin="0,0,8,0" Height="32" />
                        <ui:Button x:Name="BtnBrowseFolder" Grid.Column="1" Content="{loc:Loc BtnBrowse}" Appearance="Secondary" Click="BtnBrowseFolder_Click" Width="90" Height="32" />
                    </Grid>
                    <TextBlock Text="{loc:Loc KnownFolderHint}"
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Card>

            <!-- Automation Mode Section -->
            <TextBlock Text="{loc:Loc AutomationSection}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
            <ui:Card Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <RadioButton x:Name="RadioReviewEverything" GroupName="OrgMode" IsChecked="True">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{loc:Loc ModeReviewEverything}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc ModeReviewDesc}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RadioIntelligentAuto" GroupName="OrgMode" Margin="0,10,0,0">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{loc:Loc ModeIntelligentAuto}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc ModeIntelligentDesc}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RadioFullyAutomatic" GroupName="OrgMode" Margin="0,10,0,0">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{loc:Loc ModeFullyAuto}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc ModeFullyDesc}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </RadioButton>

                    <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,16,0,14" />

                    <TextBlock Text="{loc:Loc ConfidenceThreshold}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderThreshold" Grid.Column="0" Minimum="50" Maximum="95" Value="75"
                                TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderThreshold_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtThresholdValue" Grid.Column="1" Text="75 %" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Hardware & Performance Section -->
            <TextBlock Text="{loc:Loc HardwarePowerSection}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
            <ui:Card Margin="0,0,0,24" Padding="16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc AiProviderLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox x:Name="CmbHardwareBackend" Height="30" Margin="0,0,0,14">
                        <ComboBoxItem Content="{loc:Loc AiAuto}" IsSelected="True" />
                        <ComboBoxItem Content="{loc:Loc AiForceQnn}" />
                        <ComboBoxItem Content="{loc:Loc AiForceCpu}" />
                    </ComboBox>

                    <CheckBox x:Name="ChkThrottleBattery" Content="{loc:Loc OptThrottleBattery}" IsChecked="True" Margin="0,0,0,8" />
                    <CheckBox x:Name="ChkIgnoreIncomplete" Content="{loc:Loc OptIgnoreIncomplete}" IsChecked="True" Margin="0,0,0,8" />
                    <CheckBox x:Name="ChkIgnoreHidden" Content="{loc:Loc OptIgnoreHidden}" IsChecked="True" />
                </StackPanel>
            </ui:Card>

            <!-- Save Action Button -->
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="BtnSaveSettings" Content="{loc:Loc BtnSaveSettings}" Appearance="Primary"
                           Click="BtnSaveSettings_Click" Padding="20,6" Margin="0,0,12,0" />
                <TextBlock x:Name="TxtSaveFeedback" Text="" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
