<UserControl x:Class="NPUtil.App.Views.FileOrganizer.ReviewQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Fronta k revizi" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Zkontrolujte a schvalte navržená zařazení před provedením bezpečného přesunu."
                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />
        </StackPanel>

        <!-- Actions Toolbar -->
        <ui:Card Grid.Row="1" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="TaskListSquareAdd24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtPendingCount" Text="0 souborů čeká na schválení" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BtnRefresh" Content="Obnovit frontu" Click="BtnRefresh_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="BtnApproveAll" Content="Schválit vše ve frontě" Appearance="Primary" Click="BtnApproveAll_Click" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- DataGrid of Review Items -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="GridReviewQueue" SelectionChanged="GridReviewQueue_SelectionChanged" AutoGenerateColumns="False" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Název souboru" Binding="{Binding FileName}" Width="220" />
                    <DataGridTextColumn Header="Typ" Binding="{Binding Extension}" Width="65" />
                    <DataGridTextColumn Header="Navržená kategorie" Binding="{Binding SuggestedCategory}" Width="240" />
                    <DataGridTextColumn Header="Jistota" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="85" />
                    <DataGridTextColumn Header="Vysvětlení / Klíčová slova" Binding="{Binding Explanation}" Width="*" />
                    <DataGridTemplateColumn Header="Akce" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Schválit" Appearance="Primary" Click="BtnApproveRow_Click" Margin="0,0,6,0" Padding="10,2" />
                                    <ui:Button Content="Odmítnout" Appearance="Secondary" Click="BtnRejectRow_Click" Padding="10,2" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Inspector Panel for Selected Item -->
        <ui:Card Grid.Row="3" Margin="0,14,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!-- Left: Explanation & Alternative Categories -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Detail vybraného souboru" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock x:Name="TxtSelectedExplanation" Text="Vyberte soubor v tabulce pro zobrazení podrobností o sémantické analýze a alternativách." 
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,8" />

                    <StackPanel x:Name="PanelAlternatives" Visibility="Collapsed">
                        <TextBlock Text="Alternativní kategorie:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ItemsControl x:Name="ListAlternatives">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" Width="210" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Confidence, StringFormat={}(Jistota: {0:P0})}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ui:Button Content="Zvolit tuto" Click="BtnChooseAlternative_Click" Padding="8,1" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Custom Destination Override -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Změnit cílovou kategorii:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbAllCategories" Grid.Column="0" Margin="0,0,8,0" Height="30" />
                        <ui:Button x:Name="BtnApplyCustomCategory" Grid.Column="1" Content="Změnit a přesunout" Appearance="Primary" Click="BtnApplyCustomCategory_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ui:Card>

    </Grid>
</UserControl>
