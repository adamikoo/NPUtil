<UserControl x:Class="NPUtil.App.Views.FileOrganizer.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Lokální a sémantické vyhledávání" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Prohledávejte indexované soubory podle názvu, kategorie, přípony i sémantického významu obsahu."
                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />
        </StackPanel>

        <!-- Search Bar & Filters Card -->
        <ui:Card Grid.Row="1" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="TxtSearchQuery" Grid.Column="0" KeyDown="TxtSearchQuery_KeyDown"
                                PlaceholderText="Zadejte hledaný výraz nebo koncept (např. 'Cambridge English', 'faktura', 'daňový doklad')..."
                                Margin="0,0,10,0" Height="32" FontSize="13" />
                    <ui:Button x:Name="BtnSearch" Grid.Column="1" Content="Hledat" Appearance="Primary"
                               Click="BtnSearch_Click" Width="90" Height="32" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Kategorie:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbCategoryFilter" Grid.Column="1" Height="28" SelectionChanged="Filter_SelectionChanged" />

                    <TextBlock Grid.Column="3" Text="Typ souboru:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbExtensionFilter" Grid.Column="4" Height="28" SelectionChanged="Filter_SelectionChanged" />

                    <TextBlock x:Name="TxtResultCount" Grid.Column="5" Text="0 nalezených výsledků" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </ui:Card>

        <!-- Results Table -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="GridSearchResults" AutoGenerateColumns="False" SelectionChanged="GridSearchResults_SelectionChanged" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Název souboru" Binding="{Binding FileName}" Width="220" />
                    <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="200" />
                    <DataGridTextColumn Header="Typ" Binding="{Binding Extension}" Width="65" />
                    <DataGridTextColumn Header="Změněno" Binding="{Binding ModifiedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="125" />
                    <DataGridTextColumn Header="Úryvek obsahu" Binding="{Binding Snippet}" Width="*" />
                    <DataGridTextColumn Header="Relevance" Binding="{Binding RelevanceScore, StringFormat={}{0:F2}}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Selected Result Action Card -->
        <ui:Card Grid.Row="3" Margin="0,14,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtSelectedFilePath" Grid.Column="0" Text="Vyberte výsledek vyhledávání pro zobrazení cesty."
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BtnOpenFile" Content="Otevřít soubor" Appearance="Primary" Click="BtnOpenFile_Click" Margin="0,0,8,0" IsEnabled="False" />
                    <ui:Button x:Name="BtnOpenFolder" Content="Zobrazit v Průzkumníku" Appearance="Secondary" Click="BtnOpenFolder_Click" Margin="0,0,8,0" IsEnabled="False" />
                    <ui:Button x:Name="BtnCopyPath" Content="Kopírovat cestu" Appearance="Secondary" Click="BtnCopyPath_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </ui:Card>

    </Grid>
</UserControl>
