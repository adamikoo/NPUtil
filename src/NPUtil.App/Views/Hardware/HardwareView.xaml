<UserControl x:Class="NPUtil.App.Views.Hardware.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Systém a diagnostika hardwaru" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Informace o běhovém prostředí ARM64, Qualcomm Hexagon NPU a živý záznam událostí."
                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />
        </StackPanel>

        <!-- Diagnostics Cards Grid -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Platform Info Card -->
            <ui:Card Grid.Column="0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Laptop24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Hardwarová platforma" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Procesor:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                    <TextBlock x:Name="TxtProcessor" Text="Qualcomm Snapdragon X Elite" FontWeight="SemiBold" FontSize="13" Margin="0,1,0,8" />

                    <TextBlock Text="Architektura sestavení:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                    <TextBlock x:Name="TxtArch" Text="ARM64 (Nativní provádění bez emulace)" FontWeight="SemiBold" FontSize="13" Margin="0,1,0,8" />

                    <TextBlock Text="Operační systém:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                    <TextBlock x:Name="TxtOs" Text="Windows 11 ARM64" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
            </ui:Card>

            <!-- Right: AI & Power Card -->
            <ui:Card Grid.Column="2" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="AI akcelerace a napájení" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Aktivní zprostředkovatel AI:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                    <TextBlock x:Name="TxtActiveAi" Text="Qualcomm Hexagon NPU (QNN HTP)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,1,0,8" />

                    <TextBlock Text="Stav nativních knihoven QNN:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                    <TextBlock x:Name="TxtQnnStatus" Text="K dispozici (QnnHtp.dll, onnxruntime_providers_qnn.dll)" FontWeight="SemiBold" FontSize="13" Margin="0,1,0,8" />

                    <TextBlock Text="Zdroj napájení:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                    <TextBlock x:Name="TxtPowerStatus" Text="Síťové napájení (Plný výkon)" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- Live Application Logs Section -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Živý záznam událostí (Aplikační log)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <ui:Button x:Name="BtnExportLogs" Content="Exportovat záznam do souboru" Appearance="Secondary" HorizontalAlignment="Right" Click="BtnExportLogs_Click" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <TextBox x:Name="TxtLogViewer" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                         FontFamily="Consolas, monospace" FontSize="11" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="0" Padding="12" />
            </Border>
        </Grid>

    </Grid>
</UserControl>
