<ui:FluentWindow x:Class="NPUtil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="NPUtil"
        Icon="Assets/nputil.ico"
        Height="760" Width="1160"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Native Windows 11 TitleBar with Mica Integration -->
        <ui:TitleBar Grid.Row="0" Title="NPUtil — Windows Utility Suite" Icon="Assets/nputil.ico" />

        <!-- Windows 11 Settings-Style Navigation Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation View -->
            <ui:NavigationView Grid.Column="0" x:Name="RootNavigation"
                               PaneDisplayMode="Left"
                               IsPaneOpen="True"
                               IsBackButtonVisible="Collapsed"
                               SelectionChanged="RootNavigation_SelectionChanged">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="File Organizer" Tag="FileOrganizer" Icon="{ui:SymbolIcon Folder24}" />
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="System &amp; Diagnostics" Tag="Hardware" Icon="{ui:SymbolIcon DeveloperBoard24}" />
                    <ui:NavigationViewItem Content="Settings" Tag="Settings" Icon="{ui:SymbolIcon Settings24}" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- Main Content Frame -->
            <Border Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}" BorderThickness="0">
                <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden" />
            </Border>
        </Grid>

        <!-- Native Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0" Padding="16,4">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusBackend" Grid.Column="0" Text="AI Engine: Auto-detecting..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StatusMonitoring" Grid.Column="1" Text="Monitoring: Active (Downloads)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,24,0" />
                <TextBlock x:Name="StatusPower" Grid.Column="2" Text="AC Power" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>
