<Window x:Class="NPUtil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NPUtil — Windows Utility Suite"
        Icon="Assets/nputil.ico"
        Height="720" Width="1120"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Main Shell Grid (Sidebar + Main Content Area) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Title / Brand -->
                    <Border Grid.Row="0" Padding="16,18,16,12" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="NPUtil" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />
                            <TextBlock Text="Modular Windows Utility Suite" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Modules List (Expandable Architecture) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
                        <StackPanel>
                            <TextBlock Text="MODULES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextDisabledBrush}" Margin="16,8,0,6" />

                            <RadioButton x:Name="NavFileOrganizer" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="File Organizer" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Future Modules Slot Notice -->
                            <TextBlock Text="ADDITIONAL UTILITIES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextDisabledBrush}" Margin="16,18,0,6" />
                            <Border Margin="14,2,14,0" Padding="10,8" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="Future utilities register via IModule interface without changing core." 
                                           FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Nav Items (System & Settings) -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,8">
                        <StackPanel>
                            <RadioButton x:Name="NavHardware" Style="{StaticResource SidebarNavButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Hardware &amp; AI Diagnostics" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavGlobalSettings" Style="{StaticResource SidebarNavButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Suite Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1" x:Name="MainContentHost" />
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusBackend" Grid.Column="0" Text="AI Acceleration: Qualcomm Hexagon NPU (QNN HTP)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="StatusMonitoring" Grid.Column="1" Text="Monitoring: Active (Downloads)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,24,0" />
                <TextBlock x:Name="StatusPower" Grid.Column="2" Text="AC Power" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>

    </Grid>
</Window>
