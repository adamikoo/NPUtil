<ui:FluentWindow x:Class="NPUtil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:NPUtil.App.Common"
        mc:Ignorable="d"
        Title="NPUtil"
        Icon="Assets/logo.png"
        Height="760" Width="1160"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Native Windows 11 TitleBar with Mica Integration -->
        <ui:TitleBar Grid.Row="0" Title="NPUtil  |  v2.4 Core" Icon="Assets/logo.png" />

        <!-- Windows 11 Settings-Style Navigation Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation View with Acrylic styling -->
            <ui:NavigationView Grid.Column="0" x:Name="RootNavigation"
                               PaneDisplayMode="Left"
                               OpenPaneLength="240"
                               CompactPaneLength="48"
                               IsPaneOpen="True"
                               IsBackButtonVisible="Collapsed"
                               SelectionChanged="RootNavigation_SelectionChanged">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="{loc:Loc NavFileOrganizer}" Tag="FileOrganizer" Icon="{ui:SymbolIcon Folder24}" Click="RootNavItem_Click" />
                    <ui:NavigationViewItem Content="{loc:Loc NavContextAssistant}" Tag="ContextAssistant" Icon="{ui:SymbolIcon Bot24}" Click="RootNavItem_Click" />
                    <ui:NavigationViewItem Content="{loc:Loc NavSmartDataExtractor}" Tag="SmartDataExtractor" Icon="{ui:SymbolIcon DocumentTable24}" Click="RootNavItem_Click" />
                    <ui:NavigationViewItem Content="{loc:Loc NavUniversalOcr}" Tag="UniversalOcr" Icon="{ui:SymbolIcon Scan24}" Click="RootNavItem_Click" />
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="{loc:Loc NavHardware}" Tag="Hardware" Icon="{ui:SymbolIcon DeveloperBoard24}" Click="RootNavItem_Click" />
                    <ui:NavigationViewItem Content="{loc:Loc NavSettings}" Tag="Settings" Icon="{ui:SymbolIcon Settings24}" Click="RootNavItem_Click" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- Main Content Frame -->
            <Border Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}" BorderThickness="0">
                <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden" />
            </Border>
        </Grid>

        <!-- Specular Glass Status Bar matching Stitch -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceContainerLowestBrush}" 
                BorderBrush="{DynamicResource SpecularEdgeBorderBrush}" 
                BorderThickness="0,1,0,0" Padding="16,5">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: NPU Ready Status Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryContainerBrush}" Margin="0,0,6,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" Color="#60CDFF" ShadowDepth="0" Opacity="0.8" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="NPU Ready" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource OutlineVariantBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusBackend" Text="Qualcomm Hexagon V73 Active" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock x:Name="StatusMonitoring" Grid.Column="1" Text="Monitoring: Active (Downloads)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />

                <!-- Right: DirectML / Power Telemetry -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DirectML / Hexagon" FontSize="11" Foreground="{DynamicResource OutlineBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource OutlineVariantBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusPower" Text="0% Load • AC Power" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>
