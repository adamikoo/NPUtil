<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral Windows 11 Light Colors -->
    <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
    <Color x:Key="SurfaceBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#EBEBEB</Color>
    <Color x:Key="SidebarSelectedColor">#E0E0E0</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="SubtleBorderColor">#EEEEEE</Color>
    
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#5C5C5C</Color>
    <Color x:Key="TextDisabledColor">#9E9E9E</Color>
    
    <Color x:Key="AccentColor">#0067C0</Color>
    <Color x:Key="AccentHoverColor">#1975C5</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    
    <Color x:Key="SuccessColor">#0F7B0F</Color>
    <Color x:Key="WarningColor">#8F6B00</Color>
    <Color x:Key="ErrorColor">#C42B1C</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}" />
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <!-- Fluent Theme Bridge Brushes -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0067C0" />

</ResourceDictionary>
