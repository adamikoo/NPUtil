<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent Glass Ergonomics Design System - Exact Palette -->
    <!-- Surfaces & Canvas -->
    <Color x:Key="SurfaceColor">#131315</Color>
    <Color x:Key="SurfaceDimColor">#131315</Color>
    <Color x:Key="SurfaceBrightColor">#39393B</Color>
    <Color x:Key="SurfaceContainerLowestColor">#0E0E10</Color>
    <Color x:Key="SurfaceContainerLowColor">#1B1B1D</Color>
    <Color x:Key="SurfaceContainerColor">#1F1F21</Color>
    <Color x:Key="SurfaceContainerHighColor">#2A2A2C</Color>
    <Color x:Key="SurfaceContainerHighestColor">#353437</Color>
    <Color x:Key="WindowBackgroundColor">#131315</Color>
    <Color x:Key="SidebarBackgroundColor">#1B1B1D</Color>
    <Color x:Key="SidebarSelectedColor">#353437</Color>

    <!-- Typography & Foreground -->
    <Color x:Key="OnSurfaceColor">#E4E2E4</Color>
    <Color x:Key="OnSurfaceVariantColor">#BDC8CF</Color>
    <Color x:Key="OutlineColor">#889299</Color>
    <Color x:Key="OutlineVariantColor">#3E484E</Color>
    <Color x:Key="TextPrimaryColor">#E4E2E4</Color>
    <Color x:Key="TextSecondaryColor">#BDC8CF</Color>
    <Color x:Key="TextDisabledColor">#606063</Color>

    <!-- Accent Spectrum: Windows Electric Cyan & Secondary Blue -->
    <Color x:Key="PrimaryColor">#B4E4FF</Color>
    <Color x:Key="OnPrimaryColor">#003548</Color>
    <Color x:Key="PrimaryContainerColor">#60CDFF</Color>
    <Color x:Key="OnPrimaryContainerColor">#003548</Color>
    <Color x:Key="SecondaryColor">#A3C9FF</Color>
    <Color x:Key="SecondaryContainerColor">#3B93F1</Color>
    <Color x:Key="SurfaceTintColor">#74D1FF</Color>
    <Color x:Key="AccentColor">#60CDFF</Color>
    <Color x:Key="AccentHoverColor">#74D1FF</Color>
    <Color x:Key="AccentTextColor">#003548</Color>

    <!-- Tertiary (Amber/Warm) & Semantic Alerts -->
    <Color x:Key="TertiaryColor">#FFD6A4</Color>
    <Color x:Key="TertiaryContainerColor">#FCB347</Color>
    <Color x:Key="ErrorColor">#FFB4AB</Color>
    <Color x:Key="ErrorContainerColor">#93000A</Color>
    <Color x:Key="OnErrorContainerColor">#FFDAD6</Color>
    <Color x:Key="SuccessColor">#74D1FF</Color>
    <Color x:Key="WarningColor">#FCB347</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource OutlineVariantColor}" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#252528" />

    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="{StaticResource SurfaceContainerLowestColor}" />
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
    <SolidColorBrush x:Key="SurfaceTintBrush" Color="{StaticResource SurfaceTintColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />

    <!-- Fluent Theme Bridge Brushes for WPF-UI -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource SurfaceContainerHighestColor}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource SurfaceContainerHighestColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource OutlineVariantColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource SurfaceContainerLowestColor}" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource OutlineVariantColor}" />

    <!-- Specular Edge Gradient (Optical highlight for liquid glass cards) -->
    <LinearGradientBrush x:Key="SpecularEdgeBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#28FFFFFF" Offset="0.0" />
        <GradientStop Color="#08FFFFFF" Offset="0.3" />
        <GradientStop Color="#02FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryAccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#60CDFF" Offset="0.0" />
        <GradientStop Color="#3B93F1" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
